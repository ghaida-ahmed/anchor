# ---------------------------------------------------------------------------
# ANCHOR frontend. Copy to .env only if you need to override a default.
#
# NOTE: everything Vite exposes as VITE_* is compiled into the JavaScript bundle
# and is readable by anyone who opens the site. Never put a provider API key,
# a database URL or any other secret here. The frontend never talks to Gemini —
# it only talks to the ANCHOR API, which holds the credentials server-side.
# ---------------------------------------------------------------------------

# Base URL for the ANCHOR API.
#
# Development: leave UNSET. Vite proxies /api to http://127.0.0.1:8000
# (see vite.config.ts), so the app works with no configuration at all.
#
# Production: set this to the deployed API origin when the frontend and backend
# are on different hosts, e.g.
#   VITE_API_BASE_URL=https://anchor-api.example.com/api
#
# Leave it unset when a single host serves both and proxies /api itself.
VITE_API_BASE_URL=
