# ---------------------------------------------------------------------------
# Values read by docker-compose.yml. Every one has a working default, so
# `docker compose up` works without creating a .env file at all.
#
# The API's own configuration lives in backend/.env (see backend/.env.example).
# The frontend's lives in frontend/.env (see frontend/.env.example).
# ---------------------------------------------------------------------------

POSTGRES_USER=anchor
POSTGRES_PASSWORD=anchor
POSTGRES_DB=anchor
POSTGRES_PORT=5432
