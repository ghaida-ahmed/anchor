# ---------------------------------------------------------------------------
# ANCHOR API — copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- Database --------------------------------------------------------------
# SQLAlchemy URL using the psycopg 3 driver.
# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://anchor:anchor@localhost:5432/anchor

# Used only by the test suite. Create it once with:
#   docker compose exec db psql -U anchor -d postgres -c "CREATE DATABASE anchor_test"
TEST_DATABASE_URL=postgresql+psycopg://anchor:anchor@localhost:5432/anchor_test

# --- Authentication --------------------------------------------------------
# Signing key for JWT access tokens. GENERATE ONE — do not leave this blank:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# An empty value makes every session token forgeable, because JWT will sign and
# verify with an empty key. In development a blank falls back to a shared dev
# secret; outside development the application refuses to start.
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=720

# --- Uploads ---------------------------------------------------------------
# Filesystem root for the local storage backend. Relative paths resolve against
# the backend/ directory. Contents are gitignored.
UPLOAD_DIR=storage/documents
MAX_UPLOAD_BYTES=26214400

# --- CORS ------------------------------------------------------------------
# JSON array of origins allowed to call the API from a browser.
CORS_ORIGINS=["http://localhost:5173"]

# --- AI providers ----------------------------------------------------------
# Gemini is the default: its free tier makes the project runnable during
# development without a billing account. OpenAI remains supported and is selected
# by configuration alone.
#
# Generation and embeddings are chosen separately, so one can be moved without the
# other. Neither key is ever sent to the frontend.
#
# Without a key for the selected provider the API still runs: uploads succeed but
# processing marks documents `failed` with a clear message, and the RAG endpoints
# answer 503.
AI_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# --- Gemini (default) ------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Flash-Lite: grounded Q&A over supplied context needs faithful instruction
# following, not frontier reasoning. gemini-2.5-flash-lite is a proven fallback.
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
# gemini-embedding-001, not gemini-embedding-2: only -001 supports task_type
# (RETRIEVAL_DOCUMENT / RETRIEVAL_QUERY), which helps question-to-passage matching.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- OpenAI (optional) -----------------------------------------------------
# Only needed when AI_PROVIDER or EMBEDDING_PROVIDER is set to `openai`.
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Embeddings ------------------------------------------------------------
# EMBEDDING_DIMENSIONS is a property of the DATABASE COLUMN, not of a provider:
# document_chunks.embedding is vector(1536) (migration 924dcf437b93), and every
# provider must be configured to emit exactly that width.
#
#   text-embedding-3-small -> 1536 natively
#   gemini-embedding-001   -> 3072 by default, truncated to 1536 via
#                             output_dimensionality. MTEB is identical at 1536 and
#                             3072, and pgvector cannot index beyond 2000 dims.
#
# Changing this needs a migration altering the column AND a full re-embed.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# --- Chunking --------------------------------------------------------------
# Rationale in app/services/rag/chunking.py.
CHUNK_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# --- Retrieval and answering -----------------------------------------------
RAG_TOP_K_DEFAULT=5
RAG_TOP_K_MAX=20
# Cosine similarity below which a chunk counts as irrelevant. If nothing clears
# it, no LLM call is made and the tutor says it could not find the answer.
#
# Calibrated against real gemini-embedding-001 vectors over 20 queries:
# off-topic best match 0.449-0.489, on-topic 0.635-0.771. 0.55 sits in the gap.
# This floor is PROVIDER-SPECIFIC — re-measure if you change embedding model.
RAG_MIN_SIMILARITY=0.55
# Chunks more than this far below the best match are dropped, so a weak hit does
# not become a citation implying that document supported the answer.
RAG_CITATION_MARGIN=0.15
RAG_MAX_CONTEXT_TOKENS=4000
MAX_QUESTION_CHARS=1000

# Scratch database used only by scripts/evaluate_retrieval.py.
EVAL_DATABASE_URL=postgresql+psycopg://anchor:anchor@localhost:5432/anchor_eval
